@{
    Layout = null;
    var videoTitle = (string)ViewBag.VideoTitle;
    var videoId = (Guid)ViewBag.VideoId;
    var bootstrapId = (string)ViewBag.BootstrapId;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@videoTitle</title>
    <link rel="stylesheet" href="/css/player.css?v=secure-webrtc-20260516a" />
    <style>
        html, body {
            margin: 0;
            padding: 0;
            background: #000;
            overflow: hidden;
            width: 100%;
            height: 100%;
        }
        #player-root {
            width: 100vw;
            height: 100vh;
        }
        .player-shell {
            max-width: 100% !important;
            width: 100% !important;
            height: 100% !important;
            aspect-ratio: unset !important;
        }
    </style>
</head>
<body>
    <div id="player-root"
         data-video-id="@videoId"
         data-session-endpoint="/public-playback/bootstrap/@bootstrapId"
         data-heartbeat-endpoint="/embed/heartbeat"
         data-events-endpoint="/api/security/video-events">
        <div id="player-shell" class="player-shell">
            <div id="player-watermark" class="player-watermark" aria-hidden="true"></div>
            <iframe id="player-frame"
                    title="Protected video player"
                    src="about:blank"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allow="encrypted-media; autoplay"
                    sandbox="allow-scripts allow-same-origin allow-presentation"></iframe>
             <video id="player-video"
                    class="player-video"
                    hidden
                    autoplay
                    muted
                    playsinline
                    controlsList="nodownload noremoteplayback"
                    disablePictureInPicture></video>
            <div id="secure-controls" class="secure-controls" hidden>
                <button type="button" id="btn-seek-back" class="secure-control-btn">-10s</button>
                <button type="button" id="btn-play-toggle" class="secure-control-btn">Pause</button>
                <button type="button" id="btn-seek-forward" class="secure-control-btn">+10s</button>
                <button type="button" id="btn-mute-toggle" class="secure-control-btn">Unmute</button>
            </div>
            <div id="player-status" class="player-status" role="status"></div>
            <button type="button" id="btn-fullscreen" class="player-fs-btn" aria-label="Fullscreen">⛶</button>
        </div>
    </div>
    <script src="/js/player.js?v=secure-webrtc-20260516a"></script>
    <script src="/js/embed-init.js?v=secure-webrtc-20260516a"></script>
</body>
</html>
