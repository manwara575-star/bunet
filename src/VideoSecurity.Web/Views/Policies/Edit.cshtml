@model VideoSecurity.Web.Controllers.Admin.PoliciesController.PolicyEditViewModel
@{ ViewData["Title"] = $"Edit policy ({Model.Tier})"; }

<h1>Edit @Model.Tier policy</h1>

<form asp-action="Edit" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Tier" />

    <div class="col-md-4">
        <label class="form-label" asp-for="EmbedTtlSeconds">Embed TTL (seconds, 60-3600)</label>
        <input class="form-control" asp-for="EmbedTtlSeconds" type="number" min="60" max="3600" required />
        <span class="text-danger" asp-validation-for="EmbedTtlSeconds"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="HeartbeatIntervalSeconds">Heartbeat interval (5-120)</label>
        <input class="form-control" asp-for="HeartbeatIntervalSeconds" type="number" min="5" max="120" required />
        <span class="text-danger" asp-validation-for="HeartbeatIntervalSeconds"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="MaxConcurrentSessions">Max concurrent sessions (1-10)</label>
        <input class="form-control" asp-for="MaxConcurrentSessions" type="number" min="1" max="10" required />
        <span class="text-danger" asp-validation-for="MaxConcurrentSessions"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="AutoRevokeRiskThreshold">Auto-revoke risk threshold (1-100)</label>
        <input class="form-control" asp-for="AutoRevokeRiskThreshold" type="number" min="1" max="100" required />
        <span class="text-danger" asp-validation-for="AutoRevokeRiskThreshold"></span>
    </div>
    <div class="col-md-4 form-check ms-3 mt-4">
        <input class="form-check-input" asp-for="RequireWatermark" type="checkbox" />
        <label class="form-check-label" asp-for="RequireWatermark">Require watermark</label>
    </div>
    <div class="col-md-4 form-check ms-3 mt-4">
        <input class="form-check-input" asp-for="RevokeOnWatermarkTamper" type="checkbox" />
        <label class="form-check-label" asp-for="RevokeOnWatermarkTamper">Revoke on watermark tamper</label>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
