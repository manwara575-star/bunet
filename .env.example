# =============================================================================
# VideoSecurity Production Environment Variables
# Copy this file to .env and fill in real values before running docker compose
# =============================================================================

# --- Host Port (the port Docker maps on the host) ---
HOST_PORT=5102

# --- Admin Seed Account ---
SEED_ADMIN_EMAIL=admin@cifm.polytronx.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# --- Bunny.net Configuration ---
# Get these from: https://dash.bunny.net → Video Library → API
BUNNY_LIBRARY_ID=660716
BUNNY_API_KEY=
BUNNY_EMBED_TOKEN_KEY=
BUNNY_CDN_HOSTNAME=vz-9f9648ad-971.b-cdn.net
BUNNY_CDN_TOKEN_KEY=
BUNNY_WEBHOOK_SECRET=

# --- Privacy ---
PRIVACY_HASH_PEPPER=

# --- Embed System ---
EMBED_ALLOWED_DOMAINS=cifm.polytronx.com
EMBED_PUBLIC_BASE_URL=https://cifm.polytronx.com

# --- Secure WebRTC / Anti-CocoCut Mode ---
# Protected source files are stored in the Docker volume outside wwwroot.
PROTECTED_MEDIA_MAX_SOURCE_BYTES=10737418240
SECURE_PLAYBACK_ENABLED=true
SECURE_PLAYBACK_WHEP_ENDPOINT_BASE=http://mediamtx:8889
SECURE_PLAYBACK_WHEP_BEARER_TOKEN=
SECURE_PLAYBACK_START_FFMPEG=true
SECURE_PLAYBACK_FFMPEG_PATH=ffmpeg
SECURE_PLAYBACK_RTSP_PUBLISH_BASE=rtsp://mediamtx:8554
SECURE_PLAYBACK_BURN_WATERMARK=true
SECURE_PLAYBACK_WATERMARK_FONT_SIZE=28

# Browser-reachable host/IP advertised by MediaMTX ICE candidates.
# Use localhost for local Docker; use cifm.polytronx.com or the VPS public IP in production.
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=localhost
MEDIAMTX_WEBRTC_UDP_PORT=8189
